# NeoSeva backend configuration.
# Copy to .env and edit. Every key here is read by config.py and nowhere else.

# ---- Application ------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=*

# ---- Database ---------------------------------------------------------------
# DB_TARGET picks the database everything uses: local (DATABASE_URL) or supabase (SUPABASE_DATABASE_URL).
# scripts/migrate.py and seed/seed.py also take --target local|supabase to override it once.
DB_TARGET=local
DATABASE_URL=postgresql+psycopg://neoseva:neoseva@localhost:5432/neoseva
SUPABASE_DATABASE_URL=
TEST_DATABASE_URL=postgresql+psycopg://neoseva:neoseva@localhost:5432/neoseva_test
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
# Fail fast when the database is unreachable, so /health can say so.
DB_CONNECT_TIMEOUT=5

# ---- Auth master switch -----------------------------------------------------
# false => protected endpoints skip token checks and act as DEV_FAKE_USER_ID.
# Useful before sign-in exists in the apps. Never false in production.
AUTH_ENABLED=true
DEV_FAKE_USER_ID=usr_dev_local
DEV_FAKE_USER_PHONE=+919999999999

# ---- JWT --------------------------------------------------------------------
JWT_SECRET_KEY=change-me-too-at-least-32-bytes-long-please
JWT_ALGORITHM=HS256
JWT_ISSUER=neoseva
JWT_AUDIENCE=neoseva-apps
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=90
JWT_LEEWAY_SECONDS=30
JWT_ROTATE_REFRESH=true

# ---- SMS master switch ------------------------------------------------------
# false => the console provider is used regardless of SMS_PROVIDER, and the
# OTP is printed to the server log. Keep it false until DLT registration clears.
SMS_ENABLED=false
SMS_PROVIDER=console
SMS_FIXED_OTP=123456
SMS_LOG_OTP=true
# true => a provider failure does not fail the request (the code is still
# issued). Leave false in production so delivery problems are visible.
SMS_FAIL_SILENTLY=false

# ---- 2Factor.in -------------------------------------------------------------
TWOFACTOR_API_KEY=
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_SENDER_ID=
TWOFACTOR_TEMPLATE_LOGIN_EN=
TWOFACTOR_TEMPLATE_LOGIN_TE=
TWOFACTOR_TIMEOUT_SECONDS=10

# ---- OTP behaviour ----------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_BACKOFF_SECONDS=30,60,120,300
OTP_RESEND_WINDOW_HOURS=1

# ---- Media ------------------------------------------------------------------
STORAGE_BACKEND=local
MEDIA_MAX_BYTES=5242880
MEDIA_ALLOWED_CONTENT_TYPES=image/webp,image/jpeg,image/png
# Profile photos are served from here.
MEDIA_PUBLIC_ROOT=var/media/public
# Identity documents and selfies live here. No route serves this directory.
MEDIA_PRIVATE_ROOT=var/media/private
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media

# ---- Catalog ----------------------------------------------------------------
CATALOG_ETAG_ENABLED=true
CATALOG_CACHE_SECONDS=0

# ---- Admin API --------------------------------------------------------------
ADMIN_API_ENABLED=true
ADMIN_API_KEY=local-admin-key
# Created by the seed script when no admin with this name exists.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin12345
ADMIN_SESSION_HOURS=12

# ---- Background jobs --------------------------------------------------------
# Matching batches, request expiry and idempotency cleanup.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# ---- Area defaults ----------------------------------------------------------
DEFAULT_AREA_ID=geo_podalakur
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,te

# ---- Supabase (optional) ----------------------------------------------------
# Database: put the Supabase Postgres in SUPABASE_DATABASE_URL (Project Settings > Database >
# Connection string > Session pooler), e.g.
# postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# then set DB_TARGET=supabase. Never run tests against it: TEST_DATABASE_URL stays local.
# Images: set STORAGE_BACKEND=supabase and fill in the three values below.
# The service role key is a server secret. Never put it in an app or in git.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLIC_BUCKET=neoseva-public
# SUPABASE_PRIVATE_BUCKET=neoseva-private
